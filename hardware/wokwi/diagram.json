    { "type": "wokwi-text", "id": "t_title", "top": -380, "left": -70,
      "attrs": { "text": "ARDUINO MACHINE SAFETY MONITOR  -  ENR206, Ahmedabad University\nWokwi simulation of the real wiring (firmware v2.2)" } },
    { "type": "wokwi-text", "id": "t_lcd", "top": -150, "left": -70,
      "attrs": { "text": "16x2 LCD + I2C backpack (0x27)\nSDA -> A4, SCL -> A5" } },
    { "type": "wokwi-text", "id": "t_imu", "top": -320, "left": 290,
      "attrs": { "text": "MPU6050\nvibration + tilt\nI2C 0x68" } },
    { "type": "wokwi-text", "id": "t_dht", "top": -320, "left": 400,
      "attrs": { "text": "DHT22\ntemp + humidity\nDATA -> D4" } },
    { "type": "wokwi-text", "id": "t_sonar", "top": -320, "left": 520,
      "attrs": { "text": "HC-SR04 proximity\nTRIG -> D11, ECHO -> D10" } },
    { "type": "wokwi-text", "id": "t_relay", "top": -20, "left": 380,
      "attrs": { "text": "Relay module (active-low)\nIN -> D9, cuts the motor's 12 V" } },
    { "type": "wokwi-text", "id": "t_motor", "top": 190, "left": 500,
      "attrs": { "text": "MOTOR STAND-IN: Wokwi has no L298N or DC motor.\nD5 PWM (L298N ENA) goes through the relay contact\nto this LED: brightness = motor speed,\ndark when the relay cuts the power." } },
    { "type": "wokwi-text", "id": "t_leds", "top": 440, "left": 0,
      "attrs": { "text": "Status LEDs\nA0 green / A1 yellow / A2 red\n220 ohm each" } },
    { "type": "wokwi-text", "id": "t_bz", "top": 380, "left": 190,
      "attrs": { "text": "Buzzer\n+ -> D8" } },
    { "type": "wokwi-text", "id": "t_btn", "top": 380, "left": 320,
      "attrs": { "text": "GO -> D2 (start / reset)\nE-STOP -> D3 (hardware interrupt)\nboth to GND, internal pull-ups" } }
